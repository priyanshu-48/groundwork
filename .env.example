# Placeholders only. Copy to .env (git-ignored). Never commit real values.
DATABASE_URL=postgresql+asyncpg://groundwork:groundwork@localhost:5433/groundwork
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=groundwork
S3_ACCESS_KEY=s3-local-only
S3_SECRET_KEY=s3-local-only
GEMINI_API_KEY=
AI_PROVIDER=gemini
# Seconds between Gemini calls; 2 and 6.5 keep a bulk load inside free-tier limits (check AI Studio).
EMBEDDING_MIN_INTERVAL_S=0
EXTRACTION_MIN_INTERVAL_S=0
# false = skip LLM invoice extraction (free-tier daily generate_content limits can be ~20/day)
EXTRACTION_ENABLED=true
# Ordered fallback chain for generation (agent + extraction); quotas are per model, so several
# models add up. Take the names and daily limits from AI Studio's rate-limit page.
GEMINI_MODELS=
AGENT_MIN_INTERVAL_S=0
EVAL_PASSWORD=change-me-local-only
JWT_SECRET=change-me

# M9 (production only; stored in SSM there): when set, signup requires this invite code.
SIGNUP_CODE=
# M8: /admin/metrics needs this in X-Admin-Token (empty = route disabled). Generate a random one.
ADMIN_TOKEN=
# Optional cost estimate: {"model-name": [usd_per_1M_input, usd_per_1M_output]}; empty = no estimate
MODEL_PRICES=
