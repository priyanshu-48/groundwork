# Placeholders only. Copy to .env (git-ignored). Never commit real values.
DATABASE_URL=postgresql+asyncpg://groundwork:groundwork@localhost:5433/groundwork
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=groundwork
S3_ACCESS_KEY=s3-local-only
S3_SECRET_KEY=s3-local-only
GEMINI_API_KEY=
AI_PROVIDER=gemini
# Seconds between Gemini calls; 2 and 6.5 keep a bulk load inside free-tier limits (check AI Studio).
EMBEDDING_MIN_INTERVAL_S=0
EXTRACTION_MIN_INTERVAL_S=0
# false = skip LLM invoice extraction (free-tier daily generate_content limits can be ~20/day)
EXTRACTION_ENABLED=true
EVAL_PASSWORD=change-me-local-only
JWT_SECRET=change-me
